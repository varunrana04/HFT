# ─────────────────────────────────────────────────────────────────
#  HFT Engine — Environment Variables
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Binance API credentials ───────────────────────────────────────
# Obtain testnet keys at: https://testnet.binancefuture.com
BINANCE_API_KEY=your_binance_testnet_api_key_here
BINANCE_API_SECRET=your_binance_testnet_api_secret_here

# ── Execution mode ────────────────────────────────────────────────
# PAPER  → no live orders, reconcile position from API on boot (or flat if no keys)
# LIVE   → real orders submitted; requires API keys or boots will abort
BINANCE_MODE=PAPER

# ── Symbol ───────────────────────────────────────────────────────
BINANCE_SYMBOL=BTCUSDT

# ── API endpoints ────────────────────────────────────────────────
# Testnet (default):
BINANCE_BASE_URL=https://testnet.binancefuture.com
BINANCE_WS_BASE_URL=wss://fstream.binance.com

# Live (uncomment to go live — handle with care):
# BINANCE_BASE_URL=https://fapi.binance.com
# BINANCE_WS_BASE_URL=wss://fstream.binance.com

# ── C++ gateway toggle ────────────────────────────────────────────
# 1 = use C++ IXWebSocket gateway (requires hft_engine.pyd)
# 0 = use pure-Python WebSocket fallback (works without C++ build)
USE_CPP_GATEWAY=0

# ── Risk parameters ───────────────────────────────────────────────
# How long (ms) before a stale unmatched limit order is cancelled
# and a fresh one re-submitted when a new signal arrives.
STALE_ORDER_TTL_MS=5000

# ── Server ────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080

# ── Database (optional) ───────────────────────────────────────────
# PostgreSQL connection string for persistent trade logging.
# Leave blank to use CSV-only local logging.
# DATABASE_URL=postgresql://user:password@localhost:5432/hft
