# ── Python ────────────────────────────────────────────────────────────────────
# !! SECRETS — never commit !!
.env
.env.*
secrets.json
*_secrets.py

__pycache__/
*.py[cod]
*$py.class
*.pyo

# ── C++ Build / Compilation ───────────────────────────────────────────────────
build/
*.pyd
*.so
*.dll
*.o
*.obj
CMakeCache.txt
CMakeFiles/

# ── Virtual Environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
quant_env/

# ── IDEs & OS ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
.cache/
.DS_Store
Thumbs.db

# ── Data — raw files (too large for git) ──────────────────────────────────────
data/raw/
data/*.zip
data/*.csv

# ── Results — generated experiment outputs ────────────────────────────────────
results/paper_trades/
results/walk_forward/fold_*/
results/walk_forward/wf_metrics.csv
results/*.csv
results/live_session_*

# Explicitly track essential quantitative benchmark and report charts
!results/*.png
!results/charts/*.png
!results/report_charts/*.png
!results/walk_forward/*.png
!reports/charts/*.png

# ── Models — track production models in git ───────────────────────────────────
# python/ml_pipeline/models/*.txt  <- tracked (LGBM model)
# python/ml_pipeline/models/*.pt   <- tracked (RL policy)
models/*.onnx
!models/*.png
!python/models/*.png

# ── Build & Temporary directories ─────────────────────────────────────────────
build2/
build_test/

# Large data files — never commit
*.parquet
*.feather
*.h5

# ── Logs & temporary files ────────────────────────────────────────────────────
logs/
*.log
*.sqlite

# ── Node / npm (used for report generation only) ─────────────────────────────
node_modules/
package-lock.json

# ── Docs — keep source .md; ignore generated HTML intermediates ───────────────
docs/*.html

# 🛑 Portable Dependencies & Locks 🛑
portable_python/
toolchain/
*.lock